# Pi Controller Systemd Service
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

[Unit]
Description=Pi Controller - Raspberry Pi Cluster Management
Documentation=https://github.com/yourusername/pi-controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# Environment
Environment=PI_CONTROLLER_MODE={{ pi_controller_mode }}
Environment=PI_CONTROLLER_CONFIG={{ config_dir }}/config.yaml
Environment=PI_CONTROLLER_ENVIRONMENT={{ pi_controller_environment }}
{% if pi_controller_debug | default(false) %}
Environment=PI_CONTROLLER_DEBUG=true
{% endif %}

# Execution
ExecStart=/usr/local/bin/pi-controller --config {{ config_dir }}/config.yaml
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy
Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pi-controller

# Security hardening
{% if enable_security_hardening | default(false) %}
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
LockPersonality=true

# Allow write to data directory
ReadWritePaths={{ data_dir }} {{ config_dir }} {{ log_dir | default('/var/log/pi-controller') }}
{% endif %}

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
