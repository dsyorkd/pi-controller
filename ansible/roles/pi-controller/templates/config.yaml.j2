# Pi Controller Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# Host: {{ inventory_hostname }}

app:
  environment: {{ pi_controller_environment | default('production') }}
  data_dir: {{ data_dir }}
  debug: {{ pi_controller_debug | default(false) | lower }}
  mode: {{ pi_controller_mode }}

database:
  path: {{ database_path }}
  max_open_connections: {{ database_max_connections | default(25) }}
  max_idle_connections: {{ (database_max_connections | default(25) | int / 2) | int }}
  connection_max_lifetime: {{ database_connection_lifetime | default('1h') }}

api:
  port: {{ api_port }}
  read_timeout: {{ api_read_timeout | default(30) }}
  write_timeout: {{ api_write_timeout | default(30) }}
  max_request_size: {{ api_max_request_size | default('10MB') }}

grpc:
  port: {{ grpc_port }}
  max_recv_msg_size: {{ grpc_max_message_size | default('50MB') }}
  max_send_msg_size: {{ grpc_max_message_size | default('50MB') }}

websocket:
  port: {{ websocket_port }}
  max_connections: {{ websocket_max_connections | default(100) }}
  read_buffer_size: 1024
  write_buffer_size: 1024

clustering:
  enabled: true
  port: {{ cluster_port }}
  node_name: {{ inventory_hostname }}
{% if cluster_bootstrap | default(false) %}
  bootstrap: true
{% else %}
  bootstrap: false
  join_addresses:
    - {{ bootstrap_address }}:{{ cluster_port }}
{% endif %}
{% if cluster_advertise_address is defined %}
  advertise_address: {{ cluster_advertise_address }}
{% endif %}

discovery:
  enabled: true
  mdns_enabled: true
  mdns_service_name: _pi-controller._tcp
  scan_interval: 30s

gpio:
  enabled: {{ enable_gpio | default(true) | lower }}
  mock_mode: {{ gpio_mock_mode | default(false) | lower }}

logging:
  level: {{ pi_controller_log_level | default('info') }}
  format: json
  output: stdout

{% if enable_tls | default(false) %}
tls:
  enabled: true
  cert_file: {{ tls_cert_path }}
  key_file: {{ tls_key_path }}
{% endif %}

{% if enable_auth | default(false) %}
auth:
  enabled: true
  token: {{ auth_token }}
{% endif %}

webui:
  enabled: true
  port: 3000
  static_dir: /usr/share/pi-controller/webui
