# Sentry Configuration
# Required: Your Sentry DSN for error and performance monitoring
VITE_SENTRY_DSN=https://your-dsn@your-sentry-project.ingest.sentry.io/your-project-id

# Optional: Environment name (defaults to 'development' in dev mode, 'production' in build)
VITE_APP_ENV=development

# Optional: Performance monitoring sample rate (0.0 to 1.0, defaults to 0.1)
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional: Enable/disable performance tracing (defaults to true)
VITE_SENTRY_ENABLE_TRACING=true

# Optional: Enable debug mode (defaults to true in development)
VITE_SENTRY_DEBUG=false

# Optional: Application version for release tracking
VITE_APP_VERSION=1.0.0