# Build stage
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS builder

# Build arguments
ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown

# Install build dependencies
RUN apk add --no-cache git make

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the binary (no CGO needed since using periph.io pure Go GPIO library)
RUN CGO_ENABLED=0 \
    GOOS=$TARGETOS \
    GOARCH=$TARGETARCH \
    go build \
        -ldflags "-X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" \
        -o pi-agent ./cmd/pi-agent

# Final stage
FROM alpine:3.22

# Build arguments for final stage
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH

# Install runtime dependencies
# For ARM architectures (Raspberry Pi), we may need additional hardware access libraries
RUN apk add --no-cache ca-certificates tzdata && \
    if [ "$TARGETARCH" = "arm64" ] || [ "$TARGETARCH" = "arm" ]; then \
        apk add --no-cache \
            i2c-tools \
            spi-tools; \
    fi

# Create non-root user with access to hardware groups
# Note: In Kubernetes DaemonSet, privileged mode will be used for hardware access
RUN addgroup -S piagent && adduser -S piagent -G piagent

# Set working directory
WORKDIR /app

# Copy binary from builder stage
COPY --from=builder /app/pi-agent .

# Ensure binary is executable
RUN chmod +x /app/pi-agent

# Create data directory
RUN mkdir -p /app/data && chown -R piagent:piagent /app

# Switch to non-root user
USER piagent

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD /app/pi-agent version || exit 1

# Add labels for multi-arch identification
LABEL org.opencontainers.image.title="pi-agent"
LABEL org.opencontainers.image.description="Pi Agent - Hardware access agent for Raspberry Pi clusters"
LABEL org.opencontainers.image.platform="$TARGETPLATFORM"

# Run the binary
ENTRYPOINT ["/app/pi-agent"]